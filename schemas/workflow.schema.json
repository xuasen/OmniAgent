{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowDefinition",
  "description": "Schema for OmniAgent workflow definition",
  "type": "object",
  "required": ["name", "version", "graph"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "graph": {
      "$ref": "#/definitions/StateGraph"
    },
    "config": {
      "type": "object"
    }
  },
  "definitions": {
    "StateGraph": {
      "type": "object",
      "required": ["nodes", "edges", "start_node", "end_nodes"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Edge"
          }
        },
        "start_node": {
          "type": "string"
        },
        "end_nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Node": {
      "type": "object",
      "required": ["id", "node_type"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "node_type": {
          "type": "string",
          "enum": ["task", "hitl", "parallel", "decision"]
        },
        "action": {
          "type": ["string", "null"]
        },
        "adapter_id": {
          "type": ["string", "null"]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 60
        },
        "rollback_handler": {
          "type": ["string", "null"]
        },
        "config": {
          "type": "object"
        }
      }
    },
    "Edge": {
      "type": "object",
      "required": ["from_node", "to_node"],
      "properties": {
        "from_node": {
          "type": "string"
        },
        "to_node": {
          "type": "string"
        },
        "condition": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
